{
  "manifest_version": 3,
  "name": "Doomwall",
  "version": "1.2.0",
  "description": "Block distracting sites. One click on the toolbar icon turns blocking on or off. Edit the list in options.",
  "permissions": ["declarativeNetRequest", "storage", "history", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bg.js" },
  "action": { "default_title": "Doomwall", "default_popup": "popup.html", "default_icon": { "16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png" } },
  "icons": { "16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png" },
  "web_accessible_resources": [{ "resources": ["blocked.html", "blocked.js", "activity.html", "activity.js", "theme.css"], "matches": ["<all_urls>"] }],
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
